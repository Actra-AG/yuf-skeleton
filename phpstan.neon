includes:
    - vendor/actra/coding-standard/config/phpstan.neon
    - vendor/actra/coding-standard/config/phpstan-no-superglobals.neon
    # Only for legacy code, may only shrink
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    paths:
        - app
        - public
    excludePaths:
        # Compiled templates, generated at runtime
        - app/cache (?)
    # yuf classes are loaded by actra/autoloader, not by Composer
    scanDirectories:
        - vendor/actra/yuf/src
