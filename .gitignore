# Allowlist: everything is ignored, except the files and directories listed below.
# Add every new top-level file or directory here, otherwise it is not committed.
# This prevents accidental commits of secrets, dumps, builds or editor files.
*

# Allow specific core files
!/.ddev/
!/.ddev/config.yaml
!/.env.example.php
!/.gitignore
!/LICENSE
!/composer.json
!/phpstan.neon
!/README.md

# Allow specific directories
!/app/
!/app/**
!/public/
!/public/**
